#, python-format
msgid ""
"You selected %(count)s files, but you can only process at most %(max)s "
"images."
msgstr ""
"Jūs atlasījāt %(count)s failus, bet varat apstrādāt ne vairāk kā %(max)s "
"attēlus."

#: manifest_strings_autogenerated.py:2
msgid "Create tasks by selecting images directly from Google Drive"
msgstr "Veidojiet uzdevumus, atlasot attēlus tieši no Google Drive"

#: plugin.py:13
msgid "OAuth Client ID"
msgstr "OAuth klienta ID"

#: plugin.py:14
msgid "API Key"
msgstr "API atslēga"

#: plugin.py:27 plugin.py:48 templates/settings.html:5
msgid "Google Drive"
msgstr "Google Drive"

#: plugin.py:42
msgid "Settings updated."
msgstr "Iestatījumi atjaunināti."

#: templates/settings.html:6
msgid ""
"Allow users to select images from Google Drive when creating new tasks. "
"Create the credentials below in the Google Cloud Console:"
msgstr ""
"Ļaujiet lietotājiem atlasīt attēlus no Google Drive, veidojot jaunus "
"uzdevumus. Izveidojiet tālāk norādītos akreditācijas datus Google Cloud "
"Console:"

#: templates/settings.html:8
msgid ""
"Create a project and enable the <b>Google Drive API</b> and the <b>Google "
"Picker API</b>."
msgstr ""
"Izveidojiet projektu un iespējojiet <b>Google Drive API</b> un <b>Google "
"Picker API</b>."

#: templates/settings.html:9
msgid ""
"Open <b>APIs & Services → OAuth consent screen</b> (Google Auth Platform). "
"Fill in <b>Branding</b>, then in <b>Audience</b> add your users as test "
"users or publish the app."
msgstr ""
"Atveriet <b>APIs & Services → OAuth consent screen</b> (Google Auth "
"Platform). Aizpildiet <b>Branding</b>, pēc tam sadaļā <b>Audience</b> "
"pievienojiet savus lietotājus kā testa lietotājus vai publicējiet lietotni."

#: templates/settings.html:10
msgid "In <b>Data Access</b>, click <b>Add or remove scopes</b> and add:"
msgstr ""
"Sadaļā <b>Data Access</b> noklikšķiniet uz <b>Add or remove scopes</b> un "
"pievienojiet:"

#: templates/settings.html:11
msgid ""
"In <b>Clients</b>, create a client of type <b>Web application</b> and add "
"this address to the Authorized JavaScript origins:"
msgstr ""
"Sadaļā <b>Clients</b> izveidojiet klientu ar tipu <b>Web application</b> un "
"pievienojiet šo adresi pie Authorized JavaScript origins:"

#: templates/settings.html:12
msgid ""
"In <b>APIs & Services → Credentials</b>, click <b>Create credentials → API "
"key</b>. Under <b>API restrictions</b>, choose <b>Restrict key</b> and "
"select the <b>Google Drive API</b> and the <b>Google Picker API</b>. "
"Optionally, under <b>Application restrictions</b>, choose <b>Websites</b> "
"and add:"
msgstr ""
"Sadaļā <b>APIs & Services → Credentials</b> noklikšķiniet uz <b>Create "
"credentials → API key</b>. Sadaļā <b>API restrictions</b> izvēlieties "
"<b>Restrict key</b> un atlasiet <b>Google Drive API</b> un <b>Google Picker "
"API</b>. Pēc izvēles sadaļā <b>Application restrictions</b> izvēlieties "
"<b>Websites</b> un pievienojiet:"

#: templates/settings.html:14
msgid ""
"Google only accepts HTTPS addresses or http://localhost as JavaScript "
"origins."
msgstr ""
"Google kā JavaScript izcelsmes pieņem tikai HTTPS adreses vai "
"http://localhost."

#: templates/settings.html:15
msgid "Open Google Cloud Console"
msgstr "Atvērt Google Cloud Console"

#: templates/settings.html:20
msgid "Save"
msgstr "Saglabāt"
