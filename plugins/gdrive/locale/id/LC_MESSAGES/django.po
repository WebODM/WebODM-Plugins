#: api.py:52
msgid "This task is not accepting new files"
msgstr "Tugas ini tidak menerima file baru"

#: api.py:58
msgid "Missing Google Drive access token"
msgstr "Token akses Google Drive tidak ada"

#: api.py:60
msgid "No files selected"
msgstr "Tidak ada file yang dipilih"

#: api.py:66 api.py:74 api.py:76
msgid "Invalid file list"
msgstr "Daftar file tidak valid"

#: api.py:78
#, python-format
