msgstr "%(name)s bukan file yang valid"

#: api.py:89
#, python-format
msgid ""
"You selected %(count)s files, but you can only process at most %(max)s "
"images."
msgstr ""
"Anda memilih %(count)s file, tetapi Anda hanya dapat memproses paling banyak "
"%(max)s gambar."

#: manifest_strings_autogenerated.py:2
msgid "Create tasks by selecting images directly from Google Drive"
msgstr "Buat tugas dengan memilih gambar langsung dari Google Drive"

#: plugin.py:13
msgid "OAuth Client ID"
msgstr "ID Klien OAuth"

#: plugin.py:14
msgid "API Key"
msgstr "Kunci API"

#: plugin.py:27 plugin.py:48 templates/settings.html:5
msgid "Google Drive"
msgstr "Google Drive"

#: plugin.py:42
msgid "Settings updated."
msgstr "Pengaturan diperbarui."

#: templates/settings.html:6
msgid ""
"Allow users to select images from Google Drive when creating new tasks. "
"Create the credentials below in the Google Cloud Console:"
msgstr ""
"Izinkan pengguna memilih gambar dari Google Drive saat membuat tugas baru. "
"Buat kredensial berikut di Google Cloud Console:"

#: templates/settings.html:8
msgid ""
"Create a project and enable the <b>Google Drive API</b> and the <b>Google "
"Picker API</b>."
msgstr ""
"Buat proyek dan aktifkan <b>Google Drive API</b> dan <b>Google Picker "
"API</b>."

#: templates/settings.html:9
msgid ""
"Open <b>APIs & Services → OAuth consent screen</b> (Google Auth Platform). "
"Fill in <b>Branding</b>, then in <b>Audience</b> add your users as test "
"users or publish the app."
msgstr ""
"Buka <b>APIs & Services → OAuth consent screen</b> (Google Auth Platform). "
"Isi <b>Branding</b>, lalu di <b>Audience</b> tambahkan pengguna Anda sebagai "
"pengguna uji atau publikasikan aplikasi."

#: templates/settings.html:10
msgid "In <b>Data Access</b>, click <b>Add or remove scopes</b> and add:"
msgstr "Di <b>Data Access</b>, klik <b>Add or remove scopes</b> dan tambahkan:"

#: templates/settings.html:11
msgid ""
"In <b>Clients</b>, create a client of type <b>Web application</b> and add "
"this address to the Authorized JavaScript origins:"
msgstr ""
"Di <b>Clients</b>, buat klien dengan tipe <b>Web application</b> dan "
"tambahkan alamat ini ke Authorized JavaScript origins:"

#: templates/settings.html:12
msgid ""
"In <b>APIs & Services → Credentials</b>, click <b>Create credentials → API "
"key</b>. Under <b>API restrictions</b>, choose <b>Restrict key</b> and "
"select the <b>Google Drive API</b> and the <b>Google Picker API</b>. "
"Optionally, under <b>Application restrictions</b>, choose <b>Websites</b> "
"and add:"
msgstr ""
"Di <b>APIs & Services → Credentials</b>, klik <b>Create credentials → API "
"key</b>. Di bawah <b>API restrictions</b>, pilih <b>Restrict key</b> lalu "
"pilih <b>Google Drive API</b> dan <b>Google Picker API</b>. Secara opsional, "
"di bawah <b>Application restrictions</b>, pilih <b>Websites</b> dan "
"tambahkan:"

#: templates/settings.html:14
msgid ""
"Google only accepts HTTPS addresses or http://localhost as JavaScript "
"origins."
msgstr ""
"Google hanya menerima alamat HTTPS atau http://localhost sebagai JavaScript "
"origin."

#: templates/settings.html:15
msgid "Open Google Cloud Console"
msgstr "Buka Google Cloud Console"

#: templates/settings.html:20
msgid "Save"
msgstr "Simpan"
