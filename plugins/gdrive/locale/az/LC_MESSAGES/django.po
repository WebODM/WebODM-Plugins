#: api.py:89
#, python-format
msgid ""
"You selected %(count)s files, but you can only process at most %(max)s "
"images."
msgstr ""
"%(count)s fayl seçdiniz, lakin ən çoxu %(max)s şəkil emal edə bilərsiniz."

#: manifest_strings_autogenerated.py:2
msgid "Create tasks by selecting images directly from Google Drive"
msgstr "Şəkilləri birbaşa Google Drive-dan seçərək tapşırıqlar yaradın"

#: plugin.py:13
msgid "OAuth Client ID"
msgstr "OAuth Client ID"

#: plugin.py:14
msgid "API Key"
msgstr "API açarı"

#: plugin.py:27 plugin.py:48 templates/settings.html:5
msgid "Google Drive"
msgstr "Google Drive"

#: plugin.py:42
msgid "Settings updated."
msgstr "Parametrlər yeniləndi."

#: templates/settings.html:6
msgid ""
"Allow users to select images from Google Drive when creating new tasks. "
"Create the credentials below in the Google Cloud Console:"
msgstr ""
"Yeni tapşırıqlar yaradarkən istifadəçilərə Google Drive-dan şəkil seçməyə "
"icazə verin. Aşağıdakı məlumatları Google Cloud Console-da yaradın:"

#: templates/settings.html:8
msgid ""
"Create a project and enable the <b>Google Drive API</b> and the <b>Google "
"Picker API</b>."
msgstr ""
"Layihə yaradın və <b>Google Drive API</b> və <b>Google Picker API</b>-ni "
"aktivləşdirin."

#: templates/settings.html:9
msgid ""
"Open <b>APIs & Services → OAuth consent screen</b> (Google Auth Platform). "
"Fill in <b>Branding</b>, then in <b>Audience</b> add your users as test "
"users or publish the app."
msgstr ""
"<b>APIs & Services → OAuth consent screen</b> (Google Auth Platform) "
"bölməsini açın. <b>Branding</b> hissəsini doldurun, sonra <b>Audience</b> "
"bölməsində istifadəçilərinizi test istifadəçiləri kimi əlavə edin və ya "
"tətbiqi dərc edin."

#: templates/settings.html:10
msgid "In <b>Data Access</b>, click <b>Add or remove scopes</b> and add:"
msgstr ""
"<b>Data Access</b> bölməsində <b>Add or remove scopes</b> düyməsini "
"klikləyin və bunu əlavə edin:"

#: templates/settings.html:11
msgid ""
"In <b>Clients</b>, create a client of type <b>Web application</b> and add "
"this address to the Authorized JavaScript origins:"
msgstr ""
"<b>Clients</b> bölməsində <b>Web application</b> tipli müştəri yaradın və bu "
"ünvanı Authorized JavaScript origins siyahısına əlavə edin:"

#: templates/settings.html:12
msgid ""
"In <b>APIs & Services → Credentials</b>, click <b>Create credentials → API "
"key</b>. Under <b>API restrictions</b>, choose <b>Restrict key</b> and "
"select the <b>Google Drive API</b> and the <b>Google Picker API</b>. "
"Optionally, under <b>Application restrictions</b>, choose <b>Websites</b> "
"and add:"
msgstr ""
"<b>APIs & Services → Credentials</b> bölməsində <b>Create credentials → API "
"key</b> düyməsini klikləyin. <b>API restrictions</b> altında <b>Restrict "
"key</b> seçin və <b>Google Drive API</b> və <b>Google Picker API</b>-ni "
"seçin. İstəyə görə, <b>Application restrictions</b> altında <b>Websites</b> "
"seçin və bunu əlavə edin:"

#: templates/settings.html:14
msgid ""
"Google only accepts HTTPS addresses or http://localhost as JavaScript "
"origins."
msgstr ""
"Google JavaScript mənbələri kimi yalnız HTTPS ünvanlarını və ya "
"http://localhost qəbul edir."

#: templates/settings.html:15
msgid "Open Google Cloud Console"
msgstr "Google Cloud Console-u açın"

#: templates/settings.html:20
msgid "Save"
msgstr "Yadda saxla"
