#: api.py:52
msgid "This task is not accepting new files"
msgstr "Bu tapşırıq yeni faylları qəbul etmir"

#: api.py:58
msgid "Missing Google Drive access token"
msgstr "Google Drive giriş tokeni yoxdur"

#: api.py:60
msgid "No files selected"
msgstr "Heç bir fayl seçilməyib"

#: api.py:66 api.py:74 api.py:76
