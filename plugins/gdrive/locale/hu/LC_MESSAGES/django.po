#: api.py:52
msgid "This task is not accepting new files"
msgstr "Ez a feladat nem fogad új fájlokat"

#: api.py:58
msgid "Missing Google Drive access token"
msgstr "Hiányzik a Google Drive hozzáférési token"

#: api.py:60
msgid "No files selected"
msgstr "Nincs kiválasztott fájl"

#: api.py:66 api.py:74 api.py:76
msgid "Invalid file list"
msgstr "Érvénytelen fájllista"

#: api.py:78
#, python-format
msgid "Duplicate file name: %(name)s"
msgstr "Ismétlődő fájlnév: %(name)s"

#: api.py:80
#, python-format
msgid "%(name)s is not a valid file"
msgstr "%(name)s nem érvényes fájl"

#: api.py:89
#, python-format
msgid ""
"You selected %(count)s files, but you can only process at most %(max)s "
"images."
msgstr ""
"%(count)s fájlt választott ki, de legfeljebb %(max)s képet dolgozhat fel."

#: manifest_strings_autogenerated.py:2
msgid "Create tasks by selecting images directly from Google Drive"
msgstr ""
"Feladatok létrehozása képek közvetlen kiválasztásával a Google Drive-ból"

#: plugin.py:13
msgid "OAuth Client ID"
msgstr "OAuth-ügyfélazonosító"

#: plugin.py:14
msgid "API Key"
msgstr "API-kulcs"

#: plugin.py:27 plugin.py:48 templates/settings.html:5
msgid "Google Drive"
msgstr "Google Drive"

#: plugin.py:42
msgid "Settings updated."
msgstr "Beállítások frissítve."

#: templates/settings.html:6
msgid ""
"Allow users to select images from Google Drive when creating new tasks. "
"Create the credentials below in the Google Cloud Console:"
msgstr ""
"Lehetővé teszi a felhasználóknak, hogy új feladatok létrehozásakor képeket "
"válasszanak a Google Drive-ból. Hozza létre az alábbi hitelesítési adatokat "
"a Google Cloud Console-ban:"

#: templates/settings.html:8
msgid ""
"Create a project and enable the <b>Google Drive API</b> and the <b>Google "
"Picker API</b>."
msgstr ""
"Hozzon létre egy projektet, és engedélyezze a <b>Google Drive API</b>-t és a "
"<b>Google Picker API</b>-t."

#: templates/settings.html:9
msgid ""
"Open <b>APIs & Services → OAuth consent screen</b> (Google Auth Platform). "
"Fill in <b>Branding</b>, then in <b>Audience</b> add your users as test "
"users or publish the app."
msgstr ""
"Nyissa meg az <b>API-k és szolgáltatások → OAuth-hozzájárulási képernyő</b> "
"oldalt (Google Auth Platform). Töltse ki az <b>Arculat</b> részt, majd a "
"<b>Közönség</b> részben adja hozzá a felhasználókat tesztfelhasználóként, "
"vagy tegye közzé az alkalmazást."

#: templates/settings.html:10
msgid "In <b>Data Access</b>, click <b>Add or remove scopes</b> and add:"
msgstr ""
"Az <b>Adathozzáférés</b> részben kattintson a <b>Hatókörök hozzáadása vagy "
"eltávolítása</b> gombra, és adja hozzá:"

#: templates/settings.html:11
msgid ""
"In <b>Clients</b>, create a client of type <b>Web application</b> and add "
"this address to the Authorized JavaScript origins:"
msgstr ""
"Az <b>Ügyfelek</b> részben hozzon létre egy <b>Webes alkalmazás</b> típusú "
"ügyfelet, és adja hozzá ezt a címet az engedélyezett JavaScript-forrásokhoz:"

#: templates/settings.html:12
msgid ""
"In <b>APIs & Services → Credentials</b>, click <b>Create credentials → API "
"key</b>. Under <b>API restrictions</b>, choose <b>Restrict key</b> and "
"select the <b>Google Drive API</b> and the <b>Google Picker API</b>. "
"Optionally, under <b>Application restrictions</b>, choose <b>Websites</b> "
"and add:"
msgstr ""
"Az <b>API-k és szolgáltatások → Hitelesítési adatok</b> oldalon kattintson a "
"<b>Hitelesítési adatok létrehozása → API-kulcs</b> lehetőségre. Az "
"<b>API-korlátozások</b> alatt válassza a <b>Kulcs korlátozása</b> "
"lehetőséget, és jelölje ki a <b>Google Drive API</b>-t és a <b>Google Picker "
"API</b>-t. Opcionálisan az <b>Alkalmazáskorlátozások</b> alatt válassza a "
"<b>Webhelyek</b> lehetőséget, és adja hozzá:"

#: templates/settings.html:14
msgid ""
"Google only accepts HTTPS addresses or http://localhost as JavaScript "
"origins."
msgstr ""
"A Google JavaScript-forrásként csak HTTPS-címeket vagy a http://localhost "
"címet fogadja el."

#: templates/settings.html:15
msgid "Open Google Cloud Console"
msgstr "Google Cloud Console megnyitása"

#: templates/settings.html:20
msgid "Save"
msgstr "Mentés"
