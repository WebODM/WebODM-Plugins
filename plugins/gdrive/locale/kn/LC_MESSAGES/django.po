#: api.py:52
msgid "This task is not accepting new files"
msgstr "ಈ ಕಾರ್ಯವು ಹೊಸ ಫೈಲ್‌ಗಳನ್ನು ಸ್ವೀಕರಿಸುತ್ತಿಲ್ಲ"

#: api.py:58
msgid "Missing Google Drive access token"
msgstr "Google Drive ಪ್ರವೇಶ ಟೋಕನ್ ಕಾಣೆಯಾಗಿದೆ"

#: api.py:60
msgid "No files selected"
msgstr "ಯಾವುದೇ ಫೈಲ್‌ಗಳನ್ನು ಆಯ್ಕೆ ಮಾಡಿಲ್ಲ"

#: api.py:66 api.py:74 api.py:76
msgid "Invalid file list"
msgstr "ಅಮಾನ್ಯ ಫೈಲ್ ಪಟ್ಟಿ"

#: api.py:78
#, python-format
msgid "Duplicate file name: %(name)s"
msgstr "ನಕಲಿ ಫೈಲ್ ಹೆಸರು: %(name)s"

#: api.py:80
#, python-format
msgid "%(name)s is not a valid file"
msgstr "%(name)s ಮಾನ್ಯ ಫೈಲ್ ಅಲ್ಲ"

#: api.py:89
#, python-format
msgid ""
"You selected %(count)s files, but you can only process at most %(max)s "
"images."
msgstr ""
"ನೀವು %(count)s ಫೈಲ್‌ಗಳನ್ನು ಆಯ್ಕೆ ಮಾಡಿದ್ದೀರಿ, ಆದರೆ ನೀವು ಗರಿಷ್ಠ %(max)s "
"ಚಿತ್ರಗಳನ್ನು ಮಾತ್ರ ಪ್ರಕ್ರಿಯೆಗೊಳಿಸಬಹುದು."

#: manifest_strings_autogenerated.py:2
msgid "Create tasks by selecting images directly from Google Drive"
msgstr "Google Drive ನಿಂದ ನೇರವಾಗಿ ಚಿತ್ರಗಳನ್ನು ಆಯ್ಕೆ ಮಾಡಿ ಕಾರ್ಯಗಳನ್ನು ರಚಿಸಿ"

#: plugin.py:13
msgid "OAuth Client ID"
msgstr "OAuth ಕ್ಲೈಂಟ್ ID"

#: plugin.py:14
msgid "API Key"
msgstr "API ಕೀ"

#: plugin.py:27 plugin.py:48 templates/settings.html:5
msgid "Google Drive"
msgstr "Google Drive"

#: plugin.py:42
msgid "Settings updated."
msgstr "ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ನವೀಕರಿಸಲಾಗಿದೆ."

#: templates/settings.html:6
msgid ""
"Allow users to select images from Google Drive when creating new tasks. "
"Create the credentials below in the Google Cloud Console:"
msgstr ""
"ಹೊಸ ಕಾರ್ಯಗಳನ್ನು ರಚಿಸುವಾಗ Google Drive ನಿಂದ ಚಿತ್ರಗಳನ್ನು ಆಯ್ಕೆ ಮಾಡಲು "
"ಬಳಕೆದಾರರಿಗೆ ಅನುಮತಿಸಿ. Google Cloud Console ನಲ್ಲಿ ಕೆಳಗಿನ ರುಜುವಾತುಗಳನ್ನು ರಚಿಸಿ:"

#: templates/settings.html:8
msgid ""
"Create a project and enable the <b>Google Drive API</b> and the <b>Google "
"Picker API</b>."
msgstr ""
"ಒಂದು ಪ್ರಾಜೆಕ್ಟ್ ರಚಿಸಿ ಮತ್ತು <b>Google Drive API</b> ಹಾಗೂ <b>Google Picker "
"API</b> ಅನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ."

#: templates/settings.html:9
msgid ""
"Open <b>APIs & Services → OAuth consent screen</b> (Google Auth Platform). "
"Fill in <b>Branding</b>, then in <b>Audience</b> add your users as test "
"users or publish the app."
msgstr ""
"<b>APIs & Services → OAuth consent screen</b> (Google Auth Platform) "
"ತೆರೆಯಿರಿ. <b>Branding</b> ಭರ್ತಿ ಮಾಡಿ, ನಂತರ <b>Audience</b> ನಲ್ಲಿ ನಿಮ್ಮ "
"ಬಳಕೆದಾರರನ್ನು ಪರೀಕ್ಷಾ ಬಳಕೆದಾರರಾಗಿ ಸೇರಿಸಿ ಅಥವಾ ಆ್ಯಪ್ ಅನ್ನು ಪ್ರಕಟಿಸಿ."

#: templates/settings.html:10
msgid "In <b>Data Access</b>, click <b>Add or remove scopes</b> and add:"
msgstr ""
"<b>Data Access</b> ನಲ್ಲಿ, <b>Add or remove scopes</b> ಕ್ಲಿಕ್ ಮಾಡಿ ಮತ್ತು "
"ಇದನ್ನು ಸೇರಿಸಿ:"

#: templates/settings.html:11
msgid ""
"In <b>Clients</b>, create a client of type <b>Web application</b> and add "
"this address to the Authorized JavaScript origins:"
msgstr ""
"<b>Clients</b> ನಲ್ಲಿ, <b>Web application</b> ಪ್ರಕಾರದ ಕ್ಲೈಂಟ್ ರಚಿಸಿ ಮತ್ತು ಈ "
"ವಿಳಾಸವನ್ನು Authorized JavaScript origins ಗೆ ಸೇರಿಸಿ:"

#: templates/settings.html:12
msgid ""
"In <b>APIs & Services → Credentials</b>, click <b>Create credentials → API "
"key</b>. Under <b>API restrictions</b>, choose <b>Restrict key</b> and "
"select the <b>Google Drive API</b> and the <b>Google Picker API</b>. "
"Optionally, under <b>Application restrictions</b>, choose <b>Websites</b> "
"and add:"
msgstr ""
"<b>APIs & Services → Credentials</b> ನಲ್ಲಿ, <b>Create credentials → API "
"key</b> ಕ್ಲಿಕ್ ಮಾಡಿ. <b>API restrictions</b> ಅಡಿಯಲ್ಲಿ, <b>Restrict key</b> "
"ಆಯ್ಕೆಮಾಡಿ ಮತ್ತು <b>Google Drive API</b> ಹಾಗೂ <b>Google Picker API</b> "
"ಆಯ್ಕೆಮಾಡಿ. ಐಚ್ಛಿಕವಾಗಿ, <b>Application restrictions</b> ಅಡಿಯಲ್ಲಿ, "
"<b>Websites</b> ಆಯ್ಕೆಮಾಡಿ ಮತ್ತು ಇದನ್ನು ಸೇರಿಸಿ:"

#: templates/settings.html:14
msgid ""
"Google only accepts HTTPS addresses or http://localhost as JavaScript "
"origins."
msgstr ""
"Google ಕೇವಲ HTTPS ವಿಳಾಸಗಳನ್ನು ಅಥವಾ http://localhost ಅನ್ನು JavaScript origins "
"ಆಗಿ ಸ್ವೀಕರಿಸುತ್ತದೆ."

#: templates/settings.html:15
msgid "Open Google Cloud Console"
msgstr "Google Cloud Console ತೆರೆಯಿರಿ"

#: templates/settings.html:20
msgid "Save"
msgstr "ಉಳಿಸು"
