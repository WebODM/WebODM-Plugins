#: public/GDriveSource.jsx:31
#, python-format
msgid "Cannot load %(url)s"
msgstr "%(url)s yüklenemiyor"

#: public/GDriveSource.jsx:60
#, python-format
msgid "Google Drive request failed (%(status)s)"
msgstr "Google Drive isteği başarısız oldu (%(status)s)"

#: public/GDriveSource.jsx:127
msgid "Cannot retrieve processing nodes"
msgstr "İşlem düğümleri alınamıyor"

#: public/GDriveSource.jsx:191
msgid ""
"Cannot open the Google sign-in window. Please allow popups for this site."
msgstr ""
"Google oturum açma penceresi açılamıyor. Lütfen bu site için açılır "
"pencerelere izin verin."

#: public/GDriveSource.jsx:238
msgid "Select images, GCP files or a folder"
msgstr "Görüntüleri, GCP dosyalarını veya bir klasör seçin"

#: public/GDriveSource.jsx:270
#, python-format
msgid ""
"Cannot read the files in %(folder)s. Open the folder in the Google Drive "
"window and select its files instead."
msgstr ""
"%(folder)s içindeki dosyalar okunamıyor. Klasörü Google Drive penceresinde "
"açın ve bunun yerine dosyalarını seçin."

#: public/GDriveSource.jsx:275
msgid ""
"None of the selected files can be processed. Select images and GCP files."
msgstr ""
"Seçilen dosyaların hiçbiri işlenemiyor. Görüntüleri ve GCP dosyalarını seçin."

#: public/GDriveSource.jsx:278
#, python-format
msgid ""
"You selected %(count)s files, but you can only process at most %(max)s "
"images."
msgstr ""
"%(count)s dosya seçtiniz, ancak en fazla %(max)s görüntü işleyebilirsiniz."

#: public/GDriveSource.jsx:336 public/GDriveSource.jsx:351
msgid "Cannot import files from Google Drive"
msgstr "Google Drive'dan dosyalar içe aktarılamıyor"

#: public/GDriveSource.jsx:353
msgid "Google sign-in was canceled"
msgstr "Google oturum açma işlemi iptal edildi"

#: public/GDriveSource.jsx:367
msgid "From Google Drive"
msgstr "Google Drive'dan"

#: public/GDriveSource.jsx:371
msgid "Loading files from Google Drive..."
msgstr "Dosyalar Google Drive'dan yükleniyor..."
