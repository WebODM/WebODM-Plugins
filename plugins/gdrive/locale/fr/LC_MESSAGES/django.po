#, python-format
msgid ""
"You selected %(count)s files, but you can only process at most %(max)s "
"images."
msgstr ""
"Vous avez sélectionné %(count)s fichiers, mais vous ne pouvez traiter que "
"%(max)s images au maximum."

#: manifest_strings_autogenerated.py:2
msgid "Create tasks by selecting images directly from Google Drive"
msgstr ""
"Créez des tâches en sélectionnant des images directement depuis Google Drive"

#: plugin.py:13
msgid "OAuth Client ID"
msgstr "ID client OAuth"

#: plugin.py:14
msgid "API Key"
msgstr "Clé API"

#: plugin.py:27 plugin.py:48 templates/settings.html:5
msgid "Google Drive"
msgstr "Google Drive"

#: plugin.py:42
msgid "Settings updated."
msgstr "Paramètres mis à jour."

#: templates/settings.html:6
msgid ""
"Allow users to select images from Google Drive when creating new tasks. "
"Create the credentials below in the Google Cloud Console:"
msgstr ""
"Permettre aux utilisateurs de sélectionner des images depuis Google Drive "
"lors de la création de nouvelles tâches. Créez les identifiants ci-dessous "
"dans la Google Cloud Console :"

#: templates/settings.html:8
msgid ""
"Create a project and enable the <b>Google Drive API</b> and the <b>Google "
"Picker API</b>."
msgstr ""
"Créez un projet et activez la <b>Google Drive API</b> et la <b>Google Picker "
"API</b>."

#: templates/settings.html:9
msgid ""
"Open <b>APIs & Services → OAuth consent screen</b> (Google Auth Platform). "
"Fill in <b>Branding</b>, then in <b>Audience</b> add your users as test "
"users or publish the app."
msgstr ""
"Ouvrez <b>API et services → Écran de consentement OAuth</b> (Google Auth "
"Platform). Remplissez <b>Branding</b>, puis dans <b>Audience</b>, ajoutez "
"vos utilisateurs comme utilisateurs test ou publiez l'application."

#: templates/settings.html:10
msgid "In <b>Data Access</b>, click <b>Add or remove scopes</b> and add:"
msgstr ""
"Dans <b>Accès aux données</b>, cliquez sur <b>Ajouter ou supprimer des "
"champs d'application</b> et ajoutez :"

#: templates/settings.html:11
msgid ""
"In <b>Clients</b>, create a client of type <b>Web application</b> and add "
"this address to the Authorized JavaScript origins:"
msgstr ""
"Dans <b>Clients</b>, créez un client de type <b>Application Web</b> et "
"ajoutez cette adresse aux origines JavaScript autorisées :"

#: templates/settings.html:12
msgid ""
"In <b>APIs & Services → Credentials</b>, click <b>Create credentials → API "
"key</b>. Under <b>API restrictions</b>, choose <b>Restrict key</b> and "
"select the <b>Google Drive API</b> and the <b>Google Picker API</b>. "
"Optionally, under <b>Application restrictions</b>, choose <b>Websites</b> "
"and add:"
msgstr ""
"Dans <b>API et services → Identifiants</b>, cliquez sur <b>Créer des "
"identifiants → Clé API</b>. Sous <b>Restrictions d'API</b>, choisissez "
"<b>Restreindre la clé</b> et sélectionnez la <b>Google Drive API</b> et la "
"<b>Google Picker API</b>. Facultativement, sous <b>Restrictions relatives "
"aux applications</b>, choisissez <b>Sites Web</b> et ajoutez :"

#: templates/settings.html:14
msgid ""
"Google only accepts HTTPS addresses or http://localhost as JavaScript "
"origins."
msgstr ""
"Google n'accepte que les adresses HTTPS ou http://localhost comme origines "
"JavaScript."

#: templates/settings.html:15
msgid "Open Google Cloud Console"
msgstr "Ouvrir la Google Cloud Console"

#: templates/settings.html:20
msgid "Save"
msgstr "Enregistrer"
