#: api.py:52
msgid "This task is not accepting new files"
msgstr "Hindi na tumatanggap ng mga bagong file ang task na ito"

#: api.py:58
msgid "Missing Google Drive access token"
msgstr "Nawawala ang access token ng Google Drive"

#: api.py:60
msgid "No files selected"
msgstr "Walang napiling file"

#: api.py:66 api.py:74 api.py:76
msgid "Invalid file list"
msgstr "Hindi wastong listahan ng file"

#: api.py:78
#, python-format
msgid "Duplicate file name: %(name)s"
msgstr "Dobleng pangalan ng file: %(name)s"

#: api.py:80
#, python-format
msgid "%(name)s is not a valid file"
msgstr "Ang %(name)s ay hindi wastong file"

#: api.py:89
#, python-format
msgid ""
"You selected %(count)s files, but you can only process at most %(max)s "
"images."
msgstr ""
"Pumili ka ng %(count)s file, ngunit hanggang %(max)s larawan lang ang maaari "
"mong iproseso."

#: manifest_strings_autogenerated.py:2
msgid "Create tasks by selecting images directly from Google Drive"
msgstr ""
"Gumawa ng mga task sa pamamagitan ng direktang pagpili ng mga larawan mula "
"sa Google Drive"

#: plugin.py:13
msgid "OAuth Client ID"
msgstr "OAuth Client ID"

#: plugin.py:14
msgid "API Key"
msgstr "API Key"

#: plugin.py:27 plugin.py:48 templates/settings.html:5
msgid "Google Drive"
msgstr "Google Drive"

#: plugin.py:42
msgid "Settings updated."
msgstr "Na-update ang mga setting."

#: templates/settings.html:6
msgid ""
"Allow users to select images from Google Drive when creating new tasks. "
"Create the credentials below in the Google Cloud Console:"
msgstr ""
"Payagan ang mga user na pumili ng mga larawan mula sa Google Drive kapag "
"gumagawa ng mga bagong task. Gawin ang mga credential sa ibaba sa Google "
"Cloud Console:"

#: templates/settings.html:8
msgid ""
"Create a project and enable the <b>Google Drive API</b> and the <b>Google "
"Picker API</b>."
msgstr ""
"Gumawa ng proyekto at i-enable ang <b>Google Drive API</b> at ang <b>Google "
"Picker API</b>."

#: templates/settings.html:9
msgid ""
"Open <b>APIs & Services → OAuth consent screen</b> (Google Auth Platform). "
"Fill in <b>Branding</b>, then in <b>Audience</b> add your users as test "
"users or publish the app."
msgstr ""
"Buksan ang <b>APIs & Services → OAuth consent screen</b> (Google Auth "
"Platform). Punan ang <b>Branding</b>, pagkatapos sa <b>Audience</b> idagdag "
"ang iyong mga user bilang test user o i-publish ang app."

#: templates/settings.html:10
msgid "In <b>Data Access</b>, click <b>Add or remove scopes</b> and add:"
msgstr ""
"Sa <b>Data Access</b>, i-click ang <b>Add or remove scopes</b> at idagdag "
"ang:"

#: templates/settings.html:11
msgid ""
"In <b>Clients</b>, create a client of type <b>Web application</b> and add "
"this address to the Authorized JavaScript origins:"
msgstr ""
"Sa <b>Clients</b>, gumawa ng client na may uring <b>Web application</b> at "
"idagdag ang address na ito sa Authorized JavaScript origins:"

#: templates/settings.html:12
msgid ""
"In <b>APIs & Services → Credentials</b>, click <b>Create credentials → API "
"key</b>. Under <b>API restrictions</b>, choose <b>Restrict key</b> and "
"select the <b>Google Drive API</b> and the <b>Google Picker API</b>. "
"Optionally, under <b>Application restrictions</b>, choose <b>Websites</b> "
"and add:"
msgstr ""
"Sa <b>APIs & Services → Credentials</b>, i-click ang <b>Create credentials → "
"API key</b>. Sa ilalim ng <b>API restrictions</b>, piliin ang <b>Restrict "
"key</b> at piliin ang <b>Google Drive API</b> at ang <b>Google Picker "
"API</b>. Kung nais, sa ilalim ng <b>Application restrictions</b>, piliin ang "
"<b>Websites</b> at idagdag ang:"

#: templates/settings.html:14
msgid ""
"Google only accepts HTTPS addresses or http://localhost as JavaScript "
"origins."
msgstr ""
"Tumatanggap lang ang Google ng mga HTTPS address o http://localhost bilang "
"JavaScript origin."

#: templates/settings.html:15
msgid "Open Google Cloud Console"
msgstr "Buksan ang Google Cloud Console"

#: templates/settings.html:20
msgid "Save"
msgstr "I-save"
