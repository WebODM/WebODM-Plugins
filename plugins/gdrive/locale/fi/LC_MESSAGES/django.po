msgstr "%(name)s ei ole kelvollinen tiedosto"

#: api.py:89
#, python-format
msgid ""
"You selected %(count)s files, but you can only process at most %(max)s "
"images."
msgstr ""
"Valitsit %(count)s tiedostoa, mutta voit käsitellä enintään %(max)s kuvaa."

#: manifest_strings_autogenerated.py:2
msgid "Create tasks by selecting images directly from Google Drive"
msgstr "Luo tehtäviä valitsemalla kuvia suoraan Google Drivesta"

#: plugin.py:13
msgid "OAuth Client ID"
msgstr "OAuth-asiakastunnus"

#: plugin.py:14
msgid "API Key"
msgstr "API-avain"

#: plugin.py:27 plugin.py:48 templates/settings.html:5
msgid "Google Drive"
msgstr "Google Drive"

#: plugin.py:42
msgid "Settings updated."
msgstr "Asetukset päivitetty."

#: templates/settings.html:6
msgid ""
"Allow users to select images from Google Drive when creating new tasks. "
"Create the credentials below in the Google Cloud Console:"
msgstr ""
"Salli käyttäjien valita kuvia Google Drivesta uusia tehtäviä luodessaan. Luo "
"alla mainitut tunnistetiedot Google Cloud Consolessa:"

#: templates/settings.html:8
msgid ""
"Create a project and enable the <b>Google Drive API</b> and the <b>Google "
"Picker API</b>."
msgstr ""
"Luo projekti ja ota käyttöön <b>Google Drive API</b> ja <b>Google Picker "
"API</b>."

#: templates/settings.html:9
msgid ""
"Open <b>APIs & Services → OAuth consent screen</b> (Google Auth Platform). "
"Fill in <b>Branding</b>, then in <b>Audience</b> add your users as test "
"users or publish the app."
msgstr ""
"Avaa <b>APIs & Services → OAuth consent screen</b> (Google Auth Platform). "
"Täytä <b>Branding</b>-tiedot ja lisää sitten <b>Audience</b>-kohdassa "
"käyttäjäsi testikäyttäjiksi tai julkaise sovellus."

#: templates/settings.html:10
msgid "In <b>Data Access</b>, click <b>Add or remove scopes</b> and add:"
msgstr ""
"Napsauta <b>Data Access</b> -kohdassa <b>Add or remove scopes</b> ja lisää:"

#: templates/settings.html:11
msgid ""
"In <b>Clients</b>, create a client of type <b>Web application</b> and add "
"this address to the Authorized JavaScript origins:"
msgstr ""
"Luo <b>Clients</b>-kohdassa asiakas, jonka tyyppi on <b>Web application</b>, "
"ja lisää tämä osoite kohtaan Authorized JavaScript origins:"

#: templates/settings.html:12
msgid ""
"In <b>APIs & Services → Credentials</b>, click <b>Create credentials → API "
"key</b>. Under <b>API restrictions</b>, choose <b>Restrict key</b> and "
"select the <b>Google Drive API</b> and the <b>Google Picker API</b>. "
"Optionally, under <b>Application restrictions</b>, choose <b>Websites</b> "
"and add:"
msgstr ""
"Napsauta <b>APIs & Services → Credentials</b> -kohdassa <b>Create "
"credentials → API key</b>. Valitse <b>API restrictions</b> -kohdassa "
"<b>Restrict key</b> ja valitse <b>Google Drive API</b> ja <b>Google Picker "
"API</b>. Voit myös valita <b>Application restrictions</b> -kohdassa "
"<b>Websites</b> ja lisätä:"

#: templates/settings.html:14
msgid ""
"Google only accepts HTTPS addresses or http://localhost as JavaScript "
"origins."
msgstr ""
"Google hyväksyy JavaScript-alkuperiksi vain HTTPS-osoitteet tai osoitteen "
"http://localhost."

#: templates/settings.html:15
msgid "Open Google Cloud Console"
msgstr "Avaa Google Cloud Console"

#: templates/settings.html:20
msgid "Save"
msgstr "Tallenna"
