#: api.py:52
msgid "This task is not accepting new files"
msgstr "Tämä tehtävä ei ota vastaan uusia tiedostoja"

#: api.py:58
msgid "Missing Google Drive access token"
msgstr "Google Driven käyttöoikeustunnus puuttuu"

#: api.py:60
msgid "No files selected"
msgstr "Tiedostoja ei ole valittu"

#: api.py:66 api.py:74 api.py:76
msgid "Invalid file list"
msgstr "Virheellinen tiedostoluettelo"

#: api.py:78
#, python-format
msgid "Duplicate file name: %(name)s"
msgstr "Tiedostonimi on jo käytössä: %(name)s"

#: api.py:80
#, python-format
